{
  "manifest_version": 3,
  "name": "ExtrAI — Autopreenchimento",
  "version": "1.0.0",
  "description": "Preenchimento inteligente de formulários de certificados a partir de documentos extraídos pelo ExtrAI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8788/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ExtrAI Autopreenchimento",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "fill_form": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Preencher formulário na aba ativa com os dados do ExtrAI"
    }
  }
}
