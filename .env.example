# Provider/model used by this pilot.
PYDANTIC_AI_MODEL=google:gemini-3.5-flash-lite

# Required when using Gemini.
GEMINI_API_KEY=

# Optional alternative provider.
OPENAI_API_KEY=

# Local HTTP server.
HOST=127.0.0.1
PORT=8788

# Maximum upload accepted by the local pilot.
MAX_UPLOAD_BYTES=15728640

# Fallback models (comma-separated). Default: google:gemini-3.1-flash-lite
# PYDANTIC_AI_FALLBACK_MODELS=google:gemini-3.1-flash-lite

# Primary model timeout in seconds before attempting fallback. Default: 30.0
# MODEL_TIMEOUT_SECONDS=30.0

# Retries on primary model before switching to fallback model. Default: 1 (2 primary attempts, then 1 contingency attempt)
# FAST_FAIL_RETRIES=1

